# Copy this file to `.env` and fill in the values. Never put real keys here —
# this file is public on GitHub.
#
# These are server-side only (used by the functions in api/) and are never
# shipped to the browser because they lack the VITE_ prefix. In production,
# set them in Vercel → Settings → Environment Variables. Locally they are read
# by `vercel dev`.

# Chat assistant (api/chat.js) — Groq answers first, Gemini is the fallback.
# Set at least one key; set both for the fallback.
# Keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b, gemini-3.5-flash-lite)
# GROQ_MODEL=
# GEMINI_MODEL=

# Contact form (api/contact.js)
BREVO_API_KEY=
CONTACT_FROM_EMAIL=dave.uc.main.it@gmail.com
CONTACT_TO_EMAIL=dave.uc.main.it@gmail.com
