# Flowise chatbot config — copy this file to `.env` and fill in the values.
# Get both from your deployed Flowise: open the chatflow → </> API Endpoint.

VITE_FLOWISE_CHATFLOW_ID=your-chatflow-id-here
VITE_FLOWISE_API_HOST=https://your-flowise-url.up.railway.app

# Contact form (api/contact.js) — server-side only, never shipped to the browser
# because they lack the VITE_ prefix. In production, set these in Vercel →
# Settings → Environment Variables. Locally they are read by `vercel dev`.
BREVO_API_KEY=
CONTACT_FROM_EMAIL=dave.uc.main.it@gmail.com
CONTACT_TO_EMAIL=dave.uc.main.it@gmail.com
